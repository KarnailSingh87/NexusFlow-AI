# ===========================================================================
# NexusFlow AI — Frontend environment template
#
#   cp .env.example .env.local      # local development
#
# ───────────────────────────────────────────────────────────────────────────
#  SECURITY WARNING — read before editing
#
#  Any variable prefixed with NEXT_PUBLIC_ is COMPILED INTO THE BROWSER
#  BUNDLE and is readable by anyone who loads the page. Never prefix a secret
#  with NEXT_PUBLIC_.
#
#  The Nebius API key and the database DSN are listed below for completeness
#  and because some deployments centralise configuration in one file, but they
#  MUST stay server-side only. The FastAPI process is the only component that
#  ever reads NEBIUS_API_KEY — see `backend/.env.example` for the values that
#  actually matter.
# ===========================================================================

# ---------------------------------------------------------------------------
# Browser-visible configuration (SAFE to expose — never put secrets here)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=NexusFlow AI

# development | staging | production. Drives the badge in the header and
# environment-specific copy.
NEXT_PUBLIC_APP_ENV=development

# Origin of the NexusFlow FastAPI control plane, as seen *by the browser*.
#
#   Local (outside Docker):  http://localhost:8000
#   Docker Compose on one host: http://localhost:8000
#   Deployed behind a gateway:  https://api.nexusflow.example
#
# Must be listed in the backend's CORS_ORIGINS or the browser will block
# every request.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Model pre-selected in the playground. Must be a valid Nemotron model ID.
NEXT_PUBLIC_DEFAULT_MODEL=nvidia/Nemotron-3_5-Lightning

# Show the streaming (SSE) toggle in the playground.
NEXT_PUBLIC_ENABLE_STREAMING=true

# Client-side request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Server-only configuration (never sent to the browser)
# ---------------------------------------------------------------------------
# Address the Next.js server uses for Server Components and Route Handlers.
# Inside Docker Compose this is the service name, not localhost:
#   INTERNAL_API_BASE_URL=http://backend:8000
INTERNAL_API_BASE_URL=http://localhost:8000

# Secret used to sign/verify sessions minted for the UI (e.g. NextAuth, Auth.js,
# or your own middleware). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ---------------------------------------------------------------------------
# Reference only — configure these in backend/.env, not here
# ---------------------------------------------------------------------------
# The FastAPI service owns these. They are duplicated here purely so the full
# configuration surface is documented in one place.
#
# NEBIUS_API_KEY=<issued by https://tokenfactory.nebius.com/project/api-keys>
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# DATABASE_URL=postgresql+asyncpg://nexusflow:nexusflow@db:5432/nexusflow
