# ===========================================================================
# NexusFlow AI — Backend environment template
#
#   cp .env.example .env
#
# Every value below is read by app/core/config.py via pydantic-settings.
# NEVER commit the resulting .env — it is git-ignored by default.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=NexusFlow AI API
APP_SLUG=nexusflow-backend
APP_VERSION=0.1.0

# development | staging | test | production
# `production` enforces the safety rails at the bottom of app/core/config.py:
# it refuses to boot with a placeholder SECRET_KEY, a missing NEBIUS_API_KEY,
# or a wildcard CORS_ORIGINS.
APP_ENV=development

DEBUG=true
LOG_LEVEL=INFO

# All business endpoints are mounted under this prefix. Health probes are NOT
# versioned: they stay at /health, /health/live, /health/ready.
API_V1_PREFIX=/api/v1

# Set to false in production to remove /docs, /redoc and /openapi.json.
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Application secrets
# ---------------------------------------------------------------------------
# Signs session/JWT tokens. Generate a fresh value per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Full async SQLAlchemy DSN. Leave blank to have it assembled automatically
# from the POSTGRES_* values below. Use `postgresql://` or
# `postgresql+asyncpg://`; both are normalised to the asyncpg driver.
#
#   Local (outside Docker):  postgres://nexusflow:nexusflow@localhost:5432/nexusflow
#   Docker Compose:         postgresql+asyncpg://nexusflow:nexusflow@db:5432/nexusflow
DATABASE_URL=

POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow
POSTGRES_DB=nexusflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------------------
# Nebius Token Factory
# ---------------------------------------------------------------------------
# Create a key at https://tokenfactory.nebius.com/project/api-keys
# The value is shown exactly once — if you lose it, rotate the key.
NEBIUS_API_KEY=

# OpenAI-compatible inference endpoint. The trailing `/v1` is enforced: a value
# without it is normalised automatically.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

NEBIUS_TIMEOUT_SECONDS=120
NEBIUS_MAX_RETRIES=3
NEBIUS_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# NVIDIA Nemotron model defaults
# ---------------------------------------------------------------------------
# Fast tier — 30B hybrid MoE (3B active), 1M context. Best default for
# interactive work; ~$0.06/1M input, ~$0.24/1M output.
NEMOTRON_FAST_MODEL=nvidia/Nemotron-3_5-Lightning

# Balanced tier — 120B hybrid MoE (12B active), 256K context. Used as the
# default when NEMOTRON_DEFAULT_MODEL is unset. ~$0.30/$0.90 per 1M.
NEMOTRON_BALANCED_MODEL=nvidia/nemotron-3-super-120b-a12b

# Frontier tier — 550B hybrid MoE (55B active), 1M context. ~$1.00/$3.00 per 1M.
NEMOTRON_FRONTIER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Blank => falls back to NEMOTRON_BALANCED_MODEL.
NEMOTRON_DEFAULT_MODEL=nvidia/nemotron-3_5-Lightning

# Retrieval / vector-store pipelines.
NEMOTRON_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Optional allow-list. When set, only these exact model IDs may be invoked —
# anything else is rejected with 404 before reaching Nebius.
# Comma-separated or JSON array; blank = allow everything your key can reach.
#   MODEL_ALLOWLIST=nvidia/Nemotron-3_5-Lightning,nvidia/nemotron-3-super-120b-a12b
MODEL_ALLOWLIST=

# ---------------------------------------------------------------------------
# Generation defaults & guard rails
# ---------------------------------------------------------------------------
LLM_DEFAULT_TEMPERATURE=0.6
LLM_DEFAULT_MAX_TOKENS=2048
# Upper bound a client may request via `max_tokens`.
LLM_MAX_MAX_TOKENS=32768
# Requests whose messages approximate to more tokens than this are rejected
# with 422 before they are billed. ~4 characters per token.
LLM_MAX_INPUT_TOKENS=100000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated or JSON array. Must list the exact origin of the frontend.
# A bare `*` will refuse to boot under APP_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Optional infrastructure
# ---------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# First-run admin (optional)
# ---------------------------------------------------------------------------
# Only consumed by the bootstrap task; leave blank to skip user creation.
BOOTSTRAP_ADMIN_EMAIL=admin@nexusflow.local
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Container behaviour
# ---------------------------------------------------------------------------
# `docker-entrypoint.sh` runs `alembic upgrade head` when true. Set to false if
# migrations are applied by a separate release job.
RUN_MIGRATIONS=true
DB_WAIT_ATTEMPTS=30
