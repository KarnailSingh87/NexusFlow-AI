# ===========================================================================
# NexusFlow AI — root environment for Docker Compose
#
#   cp .env.example .env
#   docker compose up --build
#
# Compose reads this file automatically. It is the ONLY file Docker needs.
# Running the services directly on your host? Use backend/.env and
# frontend/.env.local instead — they are documented separately.
#
# NEVER commit .env. It is git-ignored by default.
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED — compose refuses to start without these two values
# ---------------------------------------------------------------------------
# Nebius Token Factory API key. Create one at:
#   https://tokenfactory.nebius.com/project/api-keys
# The value is displayed exactly once. Leave it empty and `docker compose up`
# will stop with a clear error rather than starting a broken stack.
NEBIUS_API_KEY=

# Signing secret for tokens/sessions. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to boot under APP_ENV=production if this is still a
# placeholder or shorter than 32 characters.
SECRET_KEY=change-me-in-production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Changing any of these after the first `up` requires a volume reset:
#   docker compose down -v
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow
POSTGRES_DB=nexusflow
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DSN handed to the backend. It is derived from the five variables above,
# so you normally leave it alone; set it explicitly only to point the API at an
# external Postgres. Note the `db` hostname: inside the Compose network that is
# the service name, not localhost.
#   docker-compose.yml uses: ${DATABASE_URL:-postgresql+asyncpg://...}
DATABASE_URL=postgresql+asyncpg://nexusflow:nexusflow@db:5432/nexusflow

# Apply Alembic migrations on container start (see backend/docker-entrypoint.sh).
# Set to false if you manage migrations yourself.
RUN_MIGRATIONS=true
DB_WAIT_ATTEMPTS=30

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Recycle pooled connections after this age, staying under the idle timeout
# imposed by pgbouncer and most managed-Postgres proxies.
DB_POOL_RECYCLE_SECONDS=1800
# Ping a connection before handing it out, so a database restart cannot surface
# as a failed request.
DB_POOL_PRE_PING=true
# Start-up pool warm-up: how many times to try, and how long to wait between
# attempts (the delay grows with each attempt).
DB_CONNECT_RETRIES=5
DB_CONNECT_BACKOFF_SECONDS=1.0
# When false, an unreachable database at start-up logs a warning and the API
# still comes up (serving /health/ready as degraded) instead of crash-looping.
# Set to true when you would rather fail fast and let the orchestrator retry.
DB_FAIL_FAST=false

# ---------------------------------------------------------------------------
# Nebius Token Factory
# ---------------------------------------------------------------------------
# OpenAI-compatible endpoint. The trailing /v1 is enforced automatically.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TIMEOUT_SECONDS=120
NEBIUS_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# NVIDIA Nemotron model defaults
# ---------------------------------------------------------------------------
# Fast tier — 30B hybrid MoE (3B active), 1M context, ~$0.06/$0.24 per 1M.
NEMOTRON_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# Balanced tier — 120B hybrid MoE (12B active), 256K context, ~$0.30/$0.90.
NEMOTRON_BALANCED_MODEL=nvidia/nemotron-3-super-120b-a12b
# Frontier tier — 550B hybrid MoE (55B active), 1M context, ~$1.00/$3.00.
NEMOTRON_FRONTIER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# What the API uses when a request omits `model`.
NEMOTRON_DEFAULT_MODEL=nvidia/Nemotron-3_5-Lightning
NEMOTRON_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Optional allow-list of invokable model IDs. Blank = anything your key can reach.
MODEL_ALLOWLIST=

# ---------------------------------------------------------------------------
# Backend application
# ---------------------------------------------------------------------------
APP_NAME=NexusFlow AI API
# development | staging | production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# text = human-readable lines for a terminal; json = one JSON object per line
# for log aggregators. Both formats redact credentials.
LOG_FORMAT=text
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LLM_DEFAULT_TEMPERATURE=0.6
LLM_DEFAULT_MAX_TOKENS=2048
LLM_MAX_MAX_TOKENS=32768
LLM_MAX_INPUT_TOKENS=100000

# Browser origins allowed to call the API. Inside Docker the browser reaches
# the backend through the published localhost port.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=NexusFlow AI
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_STREAMING=true
NEXT_PUBLIC_DEFAULT_MODEL=nvidia/Nemotron-3_5-Lightning
NEXT_PUBLIC_API_TIMEOUT_MS=120000

# Server-only UI secret (sessions, Route Handlers). Optional for local dev.
APP_SECRET=

# ---------------------------------------------------------------------------
# Published host ports
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ===========================================================================
# NOTE ON NEXT_PUBLIC_* VARIABLES
#
# They are inlined into the browser bundle during `docker compose build`, not
# at container start. After changing one, rebuild without cache:
#   docker compose build --no-cache frontend && docker compose up -d
# Never prefix a secret with NEXT_PUBLIC_.
# ===========================================================================
